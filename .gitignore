# Virtualenv — cada maquina monta o seu.
.venv/
venv/

# Bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Tempo de execucao: cache e acervo do usuario. Podem ter gigabytes.
#
# A BARRA NA FRENTE e' obrigatoria: `library/` sem ela vale em QUALQUER nivel e
# barraria tambem `src/osclab/library/`, deixando o acervo.py de fora do
# repositorio — um clone que nao roda. Custou um commit para descobrir.
/cache/
/library/

# A BASE DE DADOS do usuario: dicionario de sinais, parametros de linha, KMZ
# das estruturas e o historico de registros. NAO entra no repositorio, que e'
# publico — e' dado da distribuidora. A barra na frente pelo mesmo motivo de
# cima: `base` sem ela barraria `src/osclab/formats/base.py`.
/base/
/database/
/base-*/
/bases.json

# Configuracao real: tem IP e senha de equipamento. O modelo versionado e' o
# config/config.ini.example. Uma senha de subestacao commitada fica no
# historico para sempre.
config/config.ini

# Pacote offline e distribuicao — ancorados na raiz pelo mesmo motivo:
# `build` e `dist` sao nomes plausiveis para um subpacote.
/vendor/
/dist/
/build/

# Notas com DADO DA EMPRESA: nomes de subestacao e de linha, parametros reais
# do estudo de curto, casos reais de falta. O repositorio e' publico. O que
# entra em docs/ e' o dado factual escrito com as nossas palavras.
/docs-privados/

# Ferramentas e editores
.pytest_cache/
.ruff_cache/
.vscode/
.idea/

# Windows / macOS
Thumbs.db
desktop.ini
.DS_Store

# configuração pessoal do Claude Code (permissões desta máquina)
/.claude/settings.local.json
